# Port for the QA Pilot server (UI is served from here after `npm start`)
PORT=4300

# Optional: Anthropic API key. Can also be set in the UI (Settings).
# Leave empty to use your Claude subscription through the Claude Code CLI instead.
ANTHROPIC_API_KEY=

# Optional: encryption key for stored secrets (64 hex chars). Auto-generated in data/secret.key if empty.
APP_SECRET=

# Optional: where the database, secrets, artifacts and cloned repos live (default: ./data)
QA_DATA_DIR=

# Network address the server listens on. "localhost" = only this computer (default).
# Set HOST=0.0.0.0 to let teammates on your network open http://<this-pc-ip>:4300
# (QA Pilot has no login of its own - only do this on a trusted network).
HOST=
